MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
DB_NAME=
CORS_ORIGINS=*
JWT_SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Where uploaded vehicle/CMS images are stored on disk (must be writable by the app).
# Default: <backend>/local_uploads
# LOCAL_UPLOAD_ROOT=/home/USER/backend/local_uploads

# Optional remote object storage (Emergent). Public images no longer require this
# because uploads are always saved locally too — but keep it if you already rely on it.
# EMERGENT_LLM_KEY=

# SMTP — outgoing server is your mail domain (e.g. novacarrentals.com), port 465 SSL
SMTP_HOST=novacarrentals.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=support@novacarrentals.com
SMTP_PASSWORD=
SMTP_FROM=support@novacarrentals.com
NOTIFY_EMAIL_TO=support@novacarrentals.com

# Public site URL — used to build absolute logo links in emails (optional if website_url is set in admin)
PUBLIC_WEBSITE_URL=https://novacarrentals.com

# Marketing site origin for SEO canonical URLs (optional; also set Website URL in admin Settings)
VITE_PUBLIC_SITE_URL=https://novacarrentals.com
