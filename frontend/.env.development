# When REACT_APP_BACKEND_URL is set, the app calls this host directly (e.g. https://…/api/auth/login).
# Leave REACT_APP_BACKEND_URL empty to use same-origin /api + proxy below (local FastAPI).
REACT_APP_BACKEND_URL=https://backend.novacarrentals.com
REACT_APP_API_PROXY_TARGET=https://backend.novacarrentals.com
ENABLE_HEALTH_CHECK=false
