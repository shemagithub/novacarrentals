# Copy to .env.production before `npm run build` (required for hosted static site).
# Vite bakes this into the JS bundle — dev-only proxy in vite.config.ts does NOT apply after build.
VITE_BACKEND_URL=https://backend.novacarrentals.com

# Optional: if the site is served from a subpath (e.g. /app/)
# BASE_PATH=/app/
